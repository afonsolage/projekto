// World generation settings. Loaded at server startup; invalid values fail fast.
// Height is base_height(continentalness) + peaks_and_valleys * relief_amplitude(erosion)
// + detail * detail_strength, clamped to min_height..max_height.
(
    seed: 42,
    sea_level: 64,
    min_height: 70,
    max_height: 240,
    // Fractal simplex fields. Frequency is in cells per block.
    fields: (
        continentalness: (frequency: 0.0025, octaves: 4, gain: 0.5, lacunarity: 2.0),
        erosion: (frequency: 0.004, octaves: 3, gain: 0.5, lacunarity: 2.0),
        weirdness: (frequency: 0.008, octaves: 3, gain: 0.5, lacunarity: 2.0),
        detail: (frequency: 0.06, octaves: 2, gain: 0.5, lacunarity: 2.0),
        // Climate fields used only by biome selection.
        temperature: (frequency: 0.0015, octaves: 3, gain: 0.5, lacunarity: 2.0),
        humidity: (frequency: 0.002, octaves: 3, gain: 0.5, lacunarity: 2.0),
    ),
    // Maps continentalness (-1..1) to base elevation.
    base_height: (
        points: [
            (-1.0, 100.0),
            (-0.4, 110.0),
            (0.0, 125.0),
            (0.4, 148.0),
            (0.75, 168.0),
            (1.0, 190.0),
        ],
    ),
    // Maps erosion (-1..1) to the peaks-and-valleys amplitude.
    relief_amplitude: (
        points: [
            (-1.0, 30.0),
            (-0.3, 22.0),
            (0.3, 16.0),
            (1.0, 10.0),
        ],
    ),
    detail_strength: 0.6,
    // Biome selection is the nearest point in (temperature, humidity, erosion) space.
    // Top kinds are unique per biome. Rock is also the steep kind, so the surface map is
    // a visual aid rather than a biome count.
    biomes: (
        max_slope: 1.8,
        steep: "Rock",
        deep: "Rock",
        // Parameter-space distance at which a neighbouring biome's weight reaches zero.
        transition: 0.15,
        // Vertical spacing of the shared smoothed terrace staircase.
        terrace_step: 8.0,
        entries: [
            (
                name: "Plains",
                parameters: (temperature: 0.0, humidity: 0.0, erosion: 0.2),
                shape: (
                    height_offset: -4.0,
                    relief_multiplier: 0.8,
                    terrace_strength: 0.0,
                    cave_density: 0.8,
                    overhang_strength: 2.0,
                ),
                surface: (top: "Grass", subsurface: "Dirt", subsurface_depth: 3),
            ),
            (
                name: "Forest",
                parameters: (temperature: 0.0, humidity: 0.4, erosion: 0.2),
                shape: (
                    height_offset: 0.0,
                    relief_multiplier: 0.9,
                    terrace_strength: 0.0,
                    cave_density: 1.0,
                    overhang_strength: 3.0,
                ),
                surface: (top: "Moss", subsurface: "Dirt", subsurface_depth: 3),
            ),
            (
                name: "Desert",
                parameters: (temperature: 0.4, humidity: -0.4, erosion: 0.2),
                shape: (
                    height_offset: 2.0,
                    relief_multiplier: 1.0,
                    terrace_strength: 0.6,
                    cave_density: 0.5,
                    overhang_strength: 1.0,
                ),
                surface: (top: "Sand", subsurface: "Sand", subsurface_depth: 3),
            ),
            (
                name: "Tundra",
                parameters: (temperature: -0.4, humidity: 0.0, erosion: 0.2),
                shape: (
                    height_offset: 4.0,
                    relief_multiplier: 1.1,
                    terrace_strength: 0.2,
                    cave_density: 0.6,
                    overhang_strength: 2.0,
                ),
                surface: (top: "Snow", subsurface: "Dirt", subsurface_depth: 2),
            ),
            (
                name: "Roughlands",
                parameters: (temperature: 0.0, humidity: 0.0, erosion: -0.4),
                shape: (
                    height_offset: 6.0,
                    relief_multiplier: 1.4,
                    terrace_strength: 0.3,
                    cave_density: 1.5,
                    overhang_strength: 6.0,
                ),
                surface: (top: "Rock", subsurface: "Rock", subsurface_depth: 3),
            ),
        ],
    ),
    // 3D fields are sampled on a coarse lattice and interpolated per voxel.
    caves: (
        enabled: true,
        overhang: (frequency: 0.008, octaves: 2, gain: 0.5, lacunarity: 2.0),
        overhang_strength: 6.0,
        cavern: (frequency: 0.02, octaves: 3, gain: 0.5, lacunarity: 2.0),
        cavern_threshold: 0.32,
        band: 56,
        cell_xz: 4,
        cell_y: 8,
    ),
)
